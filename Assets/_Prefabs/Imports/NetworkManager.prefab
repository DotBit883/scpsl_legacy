  m_FontData:
    m_Font: {fileID: 12800000, guid: 74705c6b822852d469d6b46c4649c40c, type: 3}
    m_FontSize: 26
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 82
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "By default, the server will be set up only for your friends.\r\nIf you
    want to start a public all-day server - please contact me at\r\nserver.verification@hubertmoszka.pl\r\nplease
    attach your server IP address <b>and</b> adress displayed in the console (~)
    while creating the game\r.\r\nWithin 24 hours I will try to join the server and
    verify it's reliability.\nPlease make sure that the server will be turned on
    during this time"
--- !u!114 &645820204304010335
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6461715932460446763}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90fb537b6042fd55be7899ba5c939f45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  polishVersion: "Domy\u015Blnie serwer zostanie utworzony tylko dla twoich znajomych.\nJe\u015Bli
    chcesz postawi\u0107 publiczny ca\u0142odobowy serwer, prosz\u0119 o kontakt
    na\nserver.verification@hubertmoszka.pl\nprosz\u0119 o do\u0142\u0105czenie do
    wiadomo\u015Bci adresu IP serwera <b>oraz</b> adresu IP, kt\xF3ry wy\u015Bwietla\n
    si\u0119 w konsoli (~) po utworzeniu gry. W ci\u0105gu 24 godzin postaram si\u0119
    zweryfikowa\u0107 istnienie serwera.\nWa\u017Cne, aby serwer przez ten czas by\u0142
    <b>aktywny</b>."
  englishVersion: "By default, the server will be set up only for your friends.\r\nIf
    you want to start a public all-day server - please contact me at\r\nserver.verification@hubertmoszka.pl\r\nplease
    attach your server IP address <b>and</b> adress displayed in the console (~)
    while creating the game\r.\r\nWithin 24 hours I will try to join the server and
    verify it's reliability.\nPlease make sure that the server will be turned on
    during this time"
