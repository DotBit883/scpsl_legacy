--- !u!114 &21418
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5083}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90fb537b6042fd55be7899ba5c939f45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  polishVersion: "Podmiot jest zbudowany z betonu i pr\u0119t\xF3w zbrojeniowych.
    \nNie mo\u017Ce si\u0119 porusza\u0107, gdy ktokolwiek na niego patrzy,\nnatomiast
    ludzie mrugaj\u0105 co pozwala na chwilowy ruch.\nZabijanie odbywa si\u0119 poprzez
    skr\u0119cenie karku u przeciwnika."
  englishVersion: 'Object appears to be an elderly humanoid, with a general apperance
    of advanced decomposition.

    SCP-106 is capable of scaling any vertical surface.

    Item
    will attempt to pull prey into its pocket dimension.'
