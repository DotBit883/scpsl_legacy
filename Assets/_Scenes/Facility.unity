  m_Script: {fileID: 11500000, guid: 90fb537b6042fd55be7899ba5c939f45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  polishVersion: "Charakterystyka:\n-Bardzo du\u017Ca szybko\u015B\u0107 poruszania
    si\u0119, gdy nikt nie patrzy na podmiot.\n-Specjalna umiej\u0119tno\u015B\u0107:
    o\u015Blepienie przeciwnik\xF3w <size=13>(szybko\u015B\u0107 regeneracji umiej\u0119tno\u015Bci
    zale\u017Cna od tego, czy ktokolwiek patrzy na podmiot)</size>.\n-Niewielka wytrzyma\u0142o\u015B\u0107."
  englishVersion: "Description:\n-Extremely high movement speed when nobody is looking
    at the subject.\n-Special ability: Blinding humans <size=13>(ability regeneration
    speed depends when someone is looking at the object\uFEFF)</size>.\n-Low durability."
