  m_Name: 
  m_EditorClassIdentifier: 
  box: {fileID: 20768}
  hints:
  - size_en: {x: 312.9, y: 125.2}
    size_pl: {x: 311.69, y: 123.9}
    content_en: After the round has started You have been noticed about Your role.
      Each role has different goals to complete. If you want to know more about it,
      press the help button (not already done).
    content_pl: "Po rozpocz\u0119ciu rundy zosta\u0142a nadana Ci rola. Ka\u017Cda
      z r\xF3l ma swoje okre\u015Blone zadania. Mo\u017Cesz dowiedzie\u0107 si\u0119
      wi\u0119cej na temat swojej postaci klikaj\u0105c klawisz pomocy. (jeszcze
      niedost\u0119pne)"
    keyName: hint_roundstart
    duration: 15
  - size_en: {x: 242.9, y: 152.5}
    size_pl: {x: 242.9, y: 136.76}
    content_en: "Some doors can be open only by a keycards with right permissions.
      You can find them around in many places. To choose a keycard select it from
      your inventory (TAB by default).\r"
    content_pl: "Niekt\xF3re drzwi wymagaj\u0105 kart dost\u0119pu o okre\u015Blonym
      poziomie uprawnie\u0144. Mo\u017Cna je znale\u017A\u0107 w wielu miejscach
      na mapie. Aby jej u\u017Cy\u0107 wybierz j\u0105 z ekiwpunku (domy\u015Blnie
      TAB)."
    keyName: hint_keycard
    duration: 15
  - size_en: {x: 325.6, y: 122.2}
    size_pl: {x: 248.8, y: 163}
    content_en: "The Alpha Warhead has been turned off. To start the detonation go
      to the main control panel in Heavy Containment Zone and make sure\r that remote
      detonation is enabled."
    content_pl: "G\u0142owica Alfa zosta\u0142a przez kogo\u015B wy\u0142\u0105czona.
      Aby rozpocz\u0105\u0107 detonacj\u0119 udaj si\u0119 do panelu w Strefie Wy\u017Cszego
      Nadzoru i upewnij si\u0119, \u017Ce d\u017Awignia zdalnej detonacji jest odpowiednio
      ustawiona."
    keyName: hint_alphafail
    duration: 15
  - size_en: {x: 217.7, y: 43.58}
    size_pl: {x: 217.7, y: 43.58}
    content_en: SCP-294 requires a coin!
    content_pl: SCP-294 wymaga monety!
    keyName: hint_alphafail
    duration: 4
  hintQueue: []
